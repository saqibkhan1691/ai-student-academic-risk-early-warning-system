# AI Student Academic Risk Early Warning System - Environment Configuration
# Copy this file to .env and fill in any custom values before running.
# Never commit .env to version control.

# CORS origins for the FastAPI backend (comma-separated)
# Default covers localhost and 127.0.0.1 for standard dev servers (5173, 8443, 3000)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173,http://localhost:8443,http://127.0.0.1:8443

# Future: Add API keys, database URLs, and authentication secrets here.
# Do NOT hardcode secrets in source code.
